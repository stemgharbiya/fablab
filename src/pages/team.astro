---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TeamCard from '../components/TeamCard.astro';
import { getCollection } from 'astro:content';

const teamMembers = (await getCollection('team')).map((entry) => entry.data);
const engineers = (await getCollection('engineers')).map((entry) => entry.data);
---

<StarlightPage frontmatter={{ title: 'Meet our Team', description: 'Browse our FabLab team directory. Access profiles, contact details, and role information for our engineers, specialists, and community members.', template: 'splash' }}>
  <section class="min-h-screen">
    <div class="container">
      <div class="mb-6 text-center lg:mb-12">
        <p class="text-lg lg:text-xl leading-relaxed text-inherit w-full text-gray-500 max-w-4xl text-left">
          From visionary leadership to creative talent, and technical wizards,
          each team member plays a pivotal role in delivering the exceptional
          service and innovative solutions.
        </p>
      </div>

      <!-- Engineers Section -->
      {engineers.length > 0 && (
        <div class="mb-16">
          <h2 class="text-2xl lg:text-3xl font-bold mb-8 text-left border-b pb-3">Engineering Team</h2>
          <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none">
            {engineers.map(member => <TeamCard member={member} />)}
          </ul>
        </div>
      )}


      <!-- Team Members Section -->
      {teamMembers.length > 0 && (
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold mb-8 text-left border-b pb-3">Team Members</h2>
          <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none">
            {teamMembers.map(member => <TeamCard member={member} />)}
          </ul>
        </div>
      )}
    </div>
  </section>
</StarlightPage>

<style>
  ul {
    padding: 0;
    margin: 0;
  }
</style>